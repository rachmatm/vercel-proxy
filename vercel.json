{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "playback/",
      "destination": "https://playback.rachmat.pro/"
    },
    {
      "source": "playback/:path*",
      "destination": "https://playback.rachmat.pro/:path*"
    },
    {
      "source": "music/",
      "destination": "https://music.youtube.com"
    },
    {
      "source": "music/:path*",
      "destination": "https://music.youtube.com/:path*"
    }
  ]
}
